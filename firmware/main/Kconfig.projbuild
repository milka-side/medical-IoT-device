menu "Medical IoT Device"

    config MIOT_WIFI_SSID
        string "Wi-Fi SSID"
        default "myssid"

    config MIOT_WIFI_PASSWORD
        string "Wi-Fi password"
        default "mypassword"

    config MIOT_SERVER_URL
        string "Server URL for SD-card uploads"
        default "http://192.168.1.100:3000"
        help
            Server address, e.g. http://192.168.1.50:3000. Only used for SD uploads.

    config MIOT_API_KEY
        string "X-API-Key header for SD uploads (leave empty if server has none)"
        default ""

    config MIOT_DEVICE_ID
        string "device_id reported to the server"
        default "esp32c6-01"

    config MIOT_SPO2_COEF_A_X100
        int "SpO2 curve SpO2 = A - B*R: A x100"
        default 11000
        help
            Intercept A in hundredths (11000 = 110.00).

    config MIOT_SPO2_COEF_B_X100
        int "SpO2 curve SpO2 = A - B*R: B x100"
        default 2500
        help
            Slope B in hundredths (2500 = 25.00).

    config MIOT_MAX30102_LEDS_SWAPPED
        bool "MAX30102 board has red and IR LEDs swapped"
        default n
        help
            Enable if the red glow shows while only LED2 is on (calibration LED test).

    config MIOT_TEMP_TISSUE_K_X100
        int "Body-temperature estimate: tissue/ambient coefficient k, x100"
        default 19
        help
            body = skin + k * (skin - room), room is read while idle.
            k = 0.19 from skin 35.43 C, room 28.83 C, body ~36.7 C.

    config MIOT_BOOT_LOCKOUT_S
        int "No measurements for this many seconds after power-on"
        range 0 3600
        default 600
        help
            Warm-up after power-on, measurements are refused. "Виміряти все одно"
            or a double press still works. 0 = off.

    config MIOT_CALIBRATION_MODE
        bool "Calibration mode (raw sensor values to serial, everything always on)"
        default n
        help
            No warm-up, all sensors always on, Wi-Fi off. Prints one line a second:
            CAL,uptime_s,temp_c_raw,ir_dc,ir_ac_rms,red_dc,red_ac_rms,R,hr,quality,spo2,finger,pulse_ok,lod,adc_sps,dup_reads
            plus ECG,<sample> at 200 Hz. Don't leave it on.

    config MIOT_LIGHT_SLEEP
        bool "Light-sleep between telemetry posts when nothing is measured"
        depends on PM_ENABLE
        default y
        help
            Light sleep between sends when idle. Stays awake while USB is plugged in.

    config MIOT_AZURE_ENABLE
        bool "Send telemetry to Azure IoT Hub"
        default y
        help
            Telemetry and commands over Azure IoT Hub (MQTT, TLS, SAS token).
            The only channel: with it off nothing is sent.

    config MIOT_AZURE_CONNECTION_STRING
        string "Azure IoT Hub device connection string"
        depends on MIOT_AZURE_ENABLE
        default ""
        help
            HostName=<hub>.azure-devices.net;DeviceId=<id>;SharedAccessKey=<key>
            Keep it in sdkconfig.defaults.local, not in git.

    config MIOT_AZURE_IDLE_PERIOD_S
        int "Seconds between idle status messages to Azure"
        depends on MIOT_AZURE_ENABLE
        range 1 3600
        default 60
        help
            One status message per this many seconds while idle (F1 = 8000/day).

endmenu
