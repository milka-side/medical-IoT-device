# Seeed XIAO ESP32-C6
CONFIG_IDF_TARGET="esp32c6"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 4 MB flash, bigger app partition (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Console on USB only: UART0 TX is GPIO16, which is ADS1293 DRDYB
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Power management off, with it the board kept dropping off USB
# CONFIG_PM_ENABLE is not set

# Calibration for this board (2026-11-08 and 2026-11-18, healthy adult):
# - LEDs are swapped on this breakout (LED1 lights the IR channel)
# - SpO2 = A - 25*R, A from one point: R 0.652 -> 98 % (no reference oximeter)
# - body temp = skin + k*(skin - room), k = 0.19 (skin 35.43, room 28.83 -> ~36.7 C)
CONFIG_MIOT_MAX30102_LEDS_SWAPPED=y
CONFIG_MIOT_SPO2_COEF_A_X100=11430
CONFIG_MIOT_SPO2_COEF_B_X100=2500
CONFIG_MIOT_TEMP_TISSUE_K_X100=19

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Dev defaults, override in sdkconfig.defaults.local
CONFIG_MIOT_WIFI_SSID="UCU_Guest"
CONFIG_MIOT_WIFI_PASSWORD=""
CONFIG_MIOT_SERVER_URL="http://10.10.241.83:3000"

# Long file names on the SD card (meas_00001.jsonl)
CONFIG_FATFS_LFN_HEAP=y
